---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTranslation } from '@/i18n';
import { getLocalizedPath, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  /** 'privacy' | 'terms' | 'cookie' */
  type: 'privacy' | 'terms' | 'cookie';
}

const { lang, type } = Astro.props;
const t = getTranslation(lang);
const legal = t.legal;
const content = type === 'privacy' ? legal.privacy : type === 'terms' ? legal.terms : legal.cookie;
---

<BaseLayout lang={lang} title={content.metaTitle} description={content.metaDescription} pathname={Astro.url.pathname}>
  <section class="px-4 pb-20 pt-28 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <a href={getLocalizedPath(lang, '/')} class="inline-flex items-center gap-2 text-sm font-semibold text-ocean hover:text-lantern">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        {legal.backHome}
      </a>
      <h1 class="mt-6 font-display text-4xl font-bold text-ocean">{content.title}</h1>
      <p class="mt-4 text-sm text-ink/60">{legal.updatedAt}</p>

      {type === 'privacy' && (
        <div class="mt-8 space-y-10 text-ink/80">
          {content.sections.map((section) => (
            <div>
              <h2 class="font-display text-2xl font-bold text-ocean">{section.heading}</h2>
              <p class="mt-3 leading-relaxed">{section.intro}</p>
              <ul class="mt-4 space-y-3">
                {section.items.map((item) => (
                  typeof item === 'string' ? (
                    <li class="rounded-2xl bg-ocean-50 p-4">{item}</li>
                  ) : (
                    <li class="rounded-2xl bg-ocean-50 p-4">
                      <p class="font-semibold text-ocean">{item.title}</p>
                      <p class="mt-1 text-sm">{item.text}</p>
                    </li>
                  )
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}

      {type === 'terms' && (
        <>
          <p class="mt-8 leading-relaxed">{content.intro}</p>
          <div class="mt-10 space-y-10 text-ink/80">
            {content.sections.map((section) => (
              <div>
                <h2 class="font-display text-2xl font-bold text-ocean">{section.heading}</h2>
                <p class="mt-3 leading-relaxed">{section.text}</p>
              </div>
            ))}
          </div>
        </>
      )}

      {type === 'cookie' && (
        <>
          <p class="mt-8 leading-relaxed">{content.intro}</p>

          <div class="mt-10 space-y-6 text-ink/80">
            {content.categories.map((cat) => (
              <div class="rounded-2xl border border-wood-200 bg-white p-6 shadow-card">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <h2 class="font-display text-xl font-bold text-ocean">{cat.name}</h2>
                    <p class="mt-2 text-sm leading-relaxed">{cat.desc}</p>
                  </div>
                  {cat.alwaysActive ? (
                    <span class="inline-flex flex-shrink-0 items-center gap-2 rounded-full bg-ocean-50 px-3 py-1 text-sm font-semibold text-ocean">
                      <span class="h-2 w-2 rounded-full bg-ocean" aria-hidden="true"></span>
                      {content.alwaysActive}
                    </span>
                  ) : (
                    <label class="flex flex-shrink-0 cursor-pointer items-center gap-3" data-cookie-group>
                      <span class="text-sm font-semibold text-ink/70" data-toggle-label>{cat.checked ? content.labelOn : content.labelOff}</span>
                      <input type="checkbox" class="peer sr-only" data-cookie-toggle={cat.id} checked={cat.checked} />
                      <span class="relative h-6 w-11 rounded-full bg-wood-300 transition peer-checked:bg-ocean" aria-hidden="true">
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
                      </span>
                    </label>
                  )}
                </div>
                {cat.subName && (
                  <div class="mt-4 rounded-2xl bg-ocean-50 p-4">
                    <p class="font-semibold text-ocean">{cat.subName}</p>
                    <p class="mt-1 text-sm">{cat.subDesc}</p>
                  </div>
                )}
              </div>
            ))}

            <div class="rounded-2xl bg-sand p-6">
              <h2 class="font-display text-xl font-bold text-ocean">{content.consentTitle}</h2>
              <p class="mt-2 text-sm leading-relaxed">{content.consentDesc}</p>
            </div>

            <div class="flex flex-wrap items-center gap-4">
              <button
                type="button"
                id="save-cookie-preferences"
                class="inline-flex items-center gap-2 rounded-full bg-ocean px-6 py-3 font-semibold text-white transition hover:bg-ocean-700"
              >
                {content.saveBtn}
              </button>
              <button
                type="button"
                id="reject-all-cookies"
                class="inline-flex items-center gap-2 rounded-full border border-wood-300 px-6 py-3 font-semibold text-ink transition hover:border-ocean hover:text-ocean"
              >
                {content.rejectBtn}
              </button>
              <p id="cookie-msg" class="hidden text-sm font-semibold text-ocean" role="status"></p>
            </div>
          </div>
        </>
      )}
    </div>
  </section>

  {type === 'cookie' && (
    <script is:inline define:vars={{ labelOn: content.labelOn, labelOff: content.labelOff, savedMsg: content.savedMsg }}>
      (function () {
        const KEY = 'chewjetty_cookie_prefs';
        const toggles = Array.from(document.querySelectorAll('[data-cookie-toggle]'));
        const msg = document.getElementById('cookie-msg');

        function syncLabel(t) {
          const group = t.closest('[data-cookie-group]');
          const label = group.querySelector('[data-toggle-label]');
          label.textContent = t.checked ? labelOn : labelOff;
        }

        function showMsg(text) {
          msg.textContent = text;
          msg.classList.remove('hidden');
          clearTimeout(showMsg._t);
          showMsg._t = setTimeout(() => msg.classList.add('hidden'), 3000);
        }

        function save() {
          const prefs = {};
          toggles.forEach((t) => {
            prefs[t.dataset.cookieToggle] = t.checked;
            syncLabel(t);
          });
          localStorage.setItem(KEY, JSON.stringify(prefs));
          showMsg(savedMsg);
        }

        function rejectAll() {
          toggles.forEach((t) => {
            if (t.dataset.cookieToggle !== 'marketing') return;
            t.checked = false;
            syncLabel(t);
          });
          save();
        }

        try {
          const prefs = JSON.parse(localStorage.getItem(KEY) || '{}');
          toggles.forEach((t) => {
            const id = t.dataset.cookieToggle;
            if (typeof prefs[id] === 'boolean') t.checked = prefs[id];
            syncLabel(t);
          });
        } catch (e) {}

        toggles.forEach((t) => t.addEventListener('change', () => syncLabel(t)));
        document.getElementById('save-cookie-preferences').addEventListener('click', save);
        document.getElementById('reject-all-cookies').addEventListener('click', rejectAll);
      })();
    </script>
  )}
</BaseLayout>
