---
import { SITE, SOCIAL_IMAGE, PHOTOS } from '@/consts';
import { buildAlternates, buildHreflangLinks, LANGUAGES, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  canonical?: string;
  /** Pathname semasa (untuk membina alternates hreflang). */
  pathname?: string;
  /** Imej LCP yang perlu dipraload (cth. imej hero laman utama). */
  preloadImage?: string;
}

const {
  title,
  description,
  lang,
  image = SOCIAL_IMAGE,
  canonical = Astro.url.pathname,
  preloadImage,
} = Astro.props;

const site = Astro.site;
const canonicalPath = canonical.endsWith('/') || canonical.split('/').pop()?.includes('.') ? canonical : `${canonical}/`;
const canonicalUrl = site ? new URL(canonicalPath, site).toString() : canonicalPath;
const ogImage = site ? new URL(image, site).toString() : image;
const ogType = 'website';
const current = LANGUAGES.find((l) => l.code === lang) ?? LANGUAGES[0];
const locale = current.code === 'zh' ? 'zh_CN' : current.code === 'ms' ? 'ms_MY' : 'en_US';
const htmlLang = current.htmlLang;
const alternates = buildAlternates(canonicalPath);
const hreflangLinks = buildHreflangLinks(canonicalPath);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="language" content={htmlLang} />

{site && <link rel="canonical" href={canonicalUrl} />}

{site &&
  hreflangLinks.map((link) => (
    <link rel="alternate" hreflang={link.hreflang} href={new URL(link.url, site).toString()} />
  ))}
{site && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0]?.url ?? '/', site).toString()} />}

{preloadImage && <link rel="preload" as="image" href={preloadImage} />}

<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content={ogType} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{site && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={PHOTOS[0].copy[lang].alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={PHOTOS[0].copy[lang].alt} />

{site && <link rel="sitemap" type="application/xml" href={new URL('/sitemap-index.xml', site).toString()} />}
