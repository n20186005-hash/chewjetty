---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GA4 from '@/components/GA4.astro';
import { SITE, ADDRESS, GEO, OPENING_HOURS, AGGREGATE_RATING, TOURIST_TYPES } from '@/consts';
import { getTranslation } from '@/i18n';
import { LANGUAGES, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  pathname?: string;
}

const {
  lang,
  title,
  description,
  image = '/gallery/chew-jetty-14.jpg',
  canonical,
  pathname,
} = Astro.props;

const t = getTranslation(lang);
const metaTitle = title ?? t.site.title;
const metaDescription = description ?? t.site.description;
const current = LANGUAGES.find((l) => l.code === lang) ?? LANGUAGES[0];

const site = Astro.site;
const baseUrl = site ? new URL('/', site).toString() : '/';
const imageUrl = site ? new URL(image, site).toString() : image;

const touristAttractionLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: SITE.name,
  description: metaDescription,
  url: baseUrl,
  image: imageUrl,
  address: ADDRESS,
  geo: GEO,
  openingHoursSpecification: [OPENING_HOURS],
  aggregateRating: AGGREGATE_RATING,
  touristType: [...TOURIST_TYPES],
  isAccessibleForFree: true,
  sameAs: [SITE.mapsUrl],
};

const faqPageLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<!doctype html>
<html lang={current.htmlLang}>
  <head>
    <BaseHead
      title={metaTitle}
      description={metaDescription}
      image={image}
      lang={lang}
      canonical={canonical}
      pathname={pathname}
    />
    <GA4 />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(touristAttractionLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPageLd)}></script>
  </head>
  <body class="flex min-h-screen flex-col bg-sand font-body text-ink">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
