---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GA4 from '@/components/GA4.astro';
import { SITE, FAQS } from '@/consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = '/gallery/chew-jetty-14.jpg',
} = Astro.props;

const site = Astro.site;
const baseUrl = site ? new URL('/', site).toString() : '/';
const imageUrl = site ? new URL(image, site).toString() : image;

const address = {
  '@type': 'PostalAddress',
  streetAddress: 'Pengkalan Weld',
  addressLocality: 'George Town',
  addressRegion: 'Pulau Pinang',
  postalCode: '10300',
  addressCountry: 'MY',
};

const geo = {
  '@type': 'GeoCoordinates',
  latitude: '5.4127175',
  longitude: '100.3397723',
};

const openingHours = {
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
  opens: '09:00',
  closes: '21:00',
};

const aggregateRating = {
  '@type': 'AggregateRating',
  ratingValue: '4.1',
  reviewCount: '8000',
  bestRating: '5',
  worstRating: '1',
};

const touristAttractionLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: SITE.name,
  description: SITE.description,
  url: baseUrl,
  image: imageUrl,
  address,
  geo,
  openingHoursSpecification: [openingHours],
  aggregateRating,
  touristType: ['Cultural tourist', 'Family visitor', 'Photographer', 'History enthusiast'],
  isAccessibleForFree: true,
  sameAs: [SITE.mapsUrl],
};

const faqPageLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <GA4 />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(touristAttractionLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPageLd)}></script>
  </head>
  <body class="flex min-h-screen flex-col bg-sand font-body text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
