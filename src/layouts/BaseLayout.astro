---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GA4 from '@/components/GA4.astro';
import { SITE, SOCIAL_IMAGE, SITE_NAMES, SITE_ALT_NAMES, ADDRESS, GEO, TOURIST_TYPES } from '@/consts';
import { getTranslation } from '@/i18n';
import { getLocalizedPath, LANGUAGES, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  pathname?: string;
  /** Imej LCP (hero) untuk dipraload — hanya laman dengan imej besar di atas fold. */
  preloadImage?: string;
  /** Benar jika badan halaman benar-benar memaparkan senarai FAQ (skema FAQPage). */
  hasFaq?: boolean;
  /** Label halaman semasa untuk BreadcrumbList (halaman bukan laman utama). */
  breadcrumb?: string;
}

const {
  lang,
  title,
  description,
  image = SOCIAL_IMAGE,
  canonical,
  pathname,
  preloadImage,
  hasFaq = false,
  breadcrumb,
} = Astro.props;

const t = getTranslation(lang);
const metaTitle = title ?? t.site.title;
const metaDescription = description ?? t.site.description;
const current = LANGUAGES.find((l) => l.code === lang) ?? LANGUAGES[0];

const site = Astro.site;
const currentPath = canonical ?? pathname ?? Astro.url.pathname;
const baseUrl = site ? new URL('/', site).toString() : '/';
const pageUrl = site ? new URL(currentPath, site).toString() : currentPath;
const imageUrl = site ? new URL(image, site).toString() : image;
const homeUrl = site ? new URL(getLocalizedPath(lang, '/'), site).toString() : getLocalizedPath(lang, '/');

const attractionName = SITE_NAMES[lang] ?? SITE.name;
const attractionAltName = SITE_ALT_NAMES[lang] ?? SITE.shortTitle;

const organizationLd = {
  '@type': 'Organization',
  '@id': `${baseUrl}#organization`,
  name: SITE.name,
  url: baseUrl,
};

const websiteLd = {
  '@type': 'WebSite',
  '@id': `${baseUrl}#website`,
  url: baseUrl,
  name: SITE.name,
  inLanguage: current.htmlLang,
  publisher: { '@id': `${baseUrl}#organization` },
};

const touristAttractionLd = {
  '@type': 'TouristAttraction',
  '@id': `${pageUrl}#attraction`,
  name: attractionName,
  alternateName: attractionAltName,
  description: metaDescription,
  url: pageUrl,
  image: imageUrl,
  inLanguage: current.htmlLang,
  address: ADDRESS,
  geo: GEO,
  touristType: [...TOURIST_TYPES],
  sameAs: [SITE.mapsUrl],
  mainEntityOfPage: pageUrl,
};

const faqPageLd = hasFaq
  ? {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: t.faq.items.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }
  : null;

const breadcrumbLd = breadcrumb
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: attractionName, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: pageUrl },
      ],
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationLd, websiteLd, hasFaq ? touristAttractionLd : null, faqPageLd, breadcrumbLd].filter(Boolean),
};
---

<!doctype html>
<html lang={current.htmlLang}>
  <head>
    <BaseHead
      title={metaTitle}
      description={metaDescription}
      image={image}
      lang={lang}
      canonical={canonical}
      pathname={pathname}
      preloadImage={preloadImage}
    />
    <GA4 />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class="flex min-h-screen flex-col bg-sand font-body text-ink">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
