---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import {
  SITE,
  KEY_INFO,
  TICKET_INFO,
  PARKING_INFO,
  BEST_TIME,
  FOOD_SPOTS,
  TRANSPORT,
  NEARBY_ATTRACTIONS,
  GALLERY,
  ITINERARY_ITEMS,
  HISTORY_TIMELINE,
  FOLK_FAITH,
  ARCHITECTURE,
  FILM_SITES,
  VISITOR_ETIQUETTE,
  SOURCES,
} from '@/consts';

const heroImage = '/gallery/chew-jetty-14.jpg';
---

<BaseLayout title={SITE.title} description={SITE.description} image={heroImage}>
  {/* Hero */}
  <section class="relative flex min-h-[85vh] items-center justify-center overflow-hidden pt-20">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt="Pemandangan Chew Jetty, jambatan kayu yang memanjang ke laut"
        class="h-full w-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-ocean/80 via-ocean/50 to-sand"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center text-white sm:px-6 lg:px-8">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-lantern-200">Tapak Warisan Dunia UNESCO</p>
      <h1 class="font-display text-5xl font-extrabold leading-tight sm:text-6xl lg:text-7xl">
        Chew Jetty
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
        Jeti Chew ialah salah satu jeti puak Cina yang masih hidup di George Town, Pulau Pinang. Jambatan kayunya yang memanjang ke laut, rumah-rumah palafit, dan lampu lentera merah menjadikannya destinasi wajib lawat.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-base">
          Buka Google Maps
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.55-4.55M19.55 5.45L15 10m4.55-4.55V10M4 20h16" />
          </svg>
        </a>
        <a href="#galeri" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-white px-6 py-3 font-semibold text-white transition hover:bg-white hover:text-ocean">
          Lihat Galeri
        </a>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 animate-bounce text-white/70 sm:block">
      <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  {/* Quick info cards */}
  <section id="info-penting" class="relative -mt-16 z-20 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-4 rounded-3xl bg-white p-6 shadow-float sm:grid-cols-2 lg:grid-cols-3">
        {KEY_INFO.map((item) => (
          <div class="flex items-start gap-4 rounded-2xl bg-sand p-5">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-ocean text-white">
              {item.label.includes('Alamat') && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              )}
              {item.label.includes('Waktu') && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              )}
              {item.label.includes('Yuran') && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              )}
              {item.label.includes('Tempoh') && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              )}
              {item.label.includes('Penilaian') && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
              )}
              {item.label.includes('Koordinat') && (
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              )}
            </div>
            <div>
              <p class="text-sm font-medium text-ink/60">{item.label}</p>
              <p class="font-semibold text-ink">{item.value}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Introduction */}
  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Kampung Atas Air Warisan Cina</h2>
        <p class="mt-6 leading-relaxed text-ink/80">
          Chew Jetty dibina pada pertengahan abad ke-19 oleh nenek moyang keluarga Chew yang berhijrah dari Kampung Xinglingshe, Daerah TongAn, Quanzhou, Fujian, China. Ia merupakan salah satu daripada enam jeti puak di George Town yang masih kekal hingga kini.
        </p>
        <p class="mt-4 leading-relaxed text-ink/80">
          Jeti ini terdiri daripada dua bahagian dengan jumlah panjang lebih 300 meter dan menempatkan kira-kira 75 unit rumah. Setiap rumah dipasang pada tiang-tiang kayu di atas air, membentuk sebuah kampung atas air yang unik dan menjadi sebahagian daripada Tapak Warisan Dunia UNESCO George Town.
        </p>
        <ul class="mt-6 space-y-3 text-ink/80">
          <li class="flex items-start gap-3"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-lantern"></span>Saksi sejarah hidup imigran Cina Hokkien</li>
          <li class="flex items-start gap-3"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-lantern"></span>Rumah palafit, tokong, dan gerai cenderamata</li>
          <li class="flex items-start gap-3"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-lantern"></span>Lokasi penggambaran filem popular</li>
        </ul>
      </div>
      <div class="img-zoom rounded-3xl shadow-float">
        <img
          src="/gallery/chew-jetty-8.jpg"
          alt="Perspektif jambatan kayu Chew Jetty diapit rumah-rumah palafit"
          class="h-full w-full rounded-3xl object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* History timeline */}
  <section id="sejarah" class="bg-ocean-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="mb-14 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Sejarah & Warisan</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">
          Dari penghijrahan orang Hokkien pada abad ke-19 hingga pengiktirafan UNESCO, berikut adalah perjalanan sejarah Chew Jetty.
        </p>
      </div>
      <ol class="relative ml-3 space-y-10 border-l-2 border-ocean-300 pl-8">
        {HISTORY_TIMELINE.map((item) => (
          <li class="relative">
            <span class="absolute -left-[44px] top-1 h-6 w-6 rounded-full bg-lantern ring-4 ring-white" aria-hidden="true"></span>
            <p class="text-sm font-bold uppercase tracking-wide text-lantern">{item.year}</p>
            <h3 class="mt-1 font-display text-xl font-bold text-ocean">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-ink/80">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Culture: folk faith, architecture, filming */}
  <section id="budaya" class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-20">
      <div>
        <div class="mb-10 text-center">
          <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">{FOLK_FAITH.title}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-ink/70">{FOLK_FAITH.intro}</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {FOLK_FAITH.items.map((item, i) => (
            <div class="card relative overflow-hidden">
              <span class="absolute right-5 top-4 font-display text-5xl font-bold text-ocean-100 select-none" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="relative font-display text-xl font-bold text-ocean">{item.title}</h3>
              <p class="relative mt-3 leading-relaxed text-ink/80">{item.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-10 text-center">
          <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">{ARCHITECTURE.title}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-ink/70">{ARCHITECTURE.intro}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {ARCHITECTURE.features.map((f) => (
            <div class="rounded-2xl bg-ocean-50 p-6 shadow-card">
              <h3 class="font-display text-lg font-bold text-ocean">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/80">{f.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-10 text-center">
          <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Lokasi Penggambaran</h2>
          <p class="mx-auto mt-4 max-w-2xl text-ink/70">Suasana unik kampung atas air menjadikan Chew Jetty pilihan para pembikin filem tempatan dan antarabangsa.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {FILM_SITES.map((f) => (
            <div class="card flex gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-lantern text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" /></svg>
              </div>
              <div>
                <h3 class="font-display text-lg font-bold text-ocean">{f.title}</h3>
                <p class="mt-2 text-ink/80">{f.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Best time */}
  <section class="bg-ocean-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">{BEST_TIME.title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">{BEST_TIME.intro}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {BEST_TIME.periods.map((p) => (
          <div class="card border-t-4 border-lantern">
            <h3 class="font-display text-xl font-bold text-ocean">{p.time}</h3>
            <p class="mt-3 text-sm font-semibold text-lantern">{p.rating}</p>
            <p class="mt-3 text-ink/80">{p.description}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 rounded-2xl bg-white p-6 text-center font-medium text-ink/80 shadow-card">
        {BEST_TIME.duration}
      </p>
    </div>
  </section>

  {/* Tickets & Parking */}
  <section id="tiket-parkir" class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">{TICKET_INFO.title}</h2>
          <p class="mt-4 text-ink/70">{TICKET_INFO.intro}</p>
          <div class="mt-8 space-y-4">
            {TICKET_INFO.items.map((t) => (
              <div class="flex items-start justify-between gap-4 rounded-2xl border border-wood-200 bg-white p-5 shadow-card">
                <div>
                  <p class="font-semibold text-ink">{t.label}</p>
                  <p class="mt-1 text-sm text-ink/60">{t.note}</p>
                </div>
                <span class="flex-shrink-0 rounded-full bg-ocean-50 px-3 py-1 text-sm font-bold text-ocean">{t.price}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">{PARKING_INFO.title}</h2>
          <p class="mt-4 text-ink/70">{PARKING_INFO.intro}</p>
          <div class="mt-8 space-y-4">
            {PARKING_INFO.options.map((o) => (
              <div class="rounded-2xl bg-sand p-5">
                <h3 class="font-semibold text-ocean">{o.name}</h3>
                <p class="mt-2 text-ink/80">{o.detail}</p>
              </div>
            ))}
          </div>
          <ul class="mt-6 space-y-2 text-sm text-ink/70">
            {PARKING_INFO.tips.map((tip) => (
              <li class="flex items-start gap-2"><span class="text-lantern">•</span>{tip}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Food */}
  <section id="makanan" class="bg-wood-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Makanan Berhampiran</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">Jangan lepaskan peluang untuk mencuba hidangan ikonik Pulau Pinang sebelum atau selepas melawat jeti.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {FOOD_SPOTS.map((food) => (
          <div class="card group transition hover:-translate-y-1 hover:shadow-float">
            <div class="mb-4 flex flex-wrap gap-2">
              {food.tags.map((tag) => (
                <span class="rounded-full bg-lantern-50 px-2.5 py-1 text-xs font-semibold text-lantern">{tag}</span>
              ))}
            </div>
            <h3 class="font-display text-xl font-bold text-ocean">{food.name}</h3>
            <p class="mt-2 text-ink/80">{food.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Transport */}
  <section id="pengangkutan" class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Pengangkutan Terperinci</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">Chew Jetty mudah dicapai dari lapangan terbang, tanah besar, atau mana-mana lokasi di George Town.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {TRANSPORT.map((t) => (
          <div class="card">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-ocean text-white">
              {t.icon === 'plane' && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>}
              {t.icon === 'bus' && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8m-8 5h8m-4 5h4m-6 2h6a2 2 0 002-2v-5H6v5a2 2 0 002 2zm4-14H8a2 2 0 00-2 2v5h12V5a2 2 0 00-2-2z" /></svg>}
              {t.icon === 'ferry' && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>}
              {t.icon === 'taxi' && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>}
            </div>
            <h3 class="font-display text-xl font-bold text-ocean">{t.mode}</h3>
            <p class="mt-2 text-sm text-ink/60">{t.summary}</p>
            <ul class="mt-4 space-y-2 text-ink/80">
              {t.options.map((opt) => (
                <li class="flex items-start gap-2"><span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-lantern"></span>{opt}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Nearby attractions */}
  <section id="berhampiran" class="bg-ocean-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Tempat Menarik Berhampiran</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">Gabungkan lawatan ke Chew Jetty dengan tarikan warisan George Town yang terletak dalam lingkungan berjalan kaki.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {NEARBY_ATTRACTIONS.map((a) => (
          <div class="card transition hover:shadow-float">
            <div class="mb-3 flex items-center justify-between">
              <h3 class="font-display text-lg font-bold text-ocean">{a.name}</h3>
              <span class="rounded-full bg-ocean-50 px-2.5 py-1 text-xs font-semibold text-ocean">{a.distance}</span>
            </div>
            <p class="text-ink/80">{a.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Gallery */}
  <section id="galeri" class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Galeri Foto</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">Lihat suasana, seni bina kayu, perahu tradisional dan warna-warna kehidupan di Chew Jetty.</p>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {GALLERY.map((img, idx) => (
          <button
            type="button"
            class="gallery-thumb img-zoom group relative aspect-[4/3] overflow-hidden rounded-2xl bg-wood-100 shadow-card focus:outline-none focus-visible:ring-2 focus-visible:ring-lantern"
            data-index={idx}
            aria-label={`Buka gambar ${idx + 1}`}
          >
            <img
              src={img.src}
              alt={img.alt}
              class="h-full w-full object-cover"
              loading={idx < 5 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="absolute inset-0 flex items-center justify-center bg-ocean/0 transition group-hover:bg-ocean/20">
              <svg class="h-8 w-8 text-white opacity-0 drop-shadow-md transition group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* Visitor etiquette */}
  <section id="etika" class="bg-wood-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">{VISITOR_ETIQUETTE.title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">{VISITOR_ETIQUETTE.intro}</p>
      </div>
