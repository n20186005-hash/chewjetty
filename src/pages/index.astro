              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </span>
            <p class="text-ink/80">{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Itinerary */}
  <section id="senarai" class="bg-sand px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Senarai Perjalanan Saya</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">Tandakan aktiviti yang ingin anda lakukan. Data disimpan di pelayar anda sahaja dan tidak dihantar ke mana-mana pihak.</p>
      </div>
      <div class="rounded-3xl bg-white p-6 shadow-float sm:p-8">
        <div class="mb-4 flex items-center justify-between">
          <span id="itinerary-count" class="text-sm font-semibold text-ocean">0 / {ITINERARY_ITEMS.length} dipilih</span>
          <button id="itinerary-reset" type="button" class="text-sm font-medium text-lantern hover:text-lantern-700">Tetapkan semula</button>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {ITINERARY_ITEMS.map((item) => (
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-wood-200 bg-sand p-4 transition hover:border-ocean-300 has-[:checked]:border-ocean has-[:checked]:bg-ocean has-[:checked]:text-white">
              <input
                type="checkbox"
                value={item.id}
                class="itinerary-check h-5 w-5 rounded border-wood-300 text-lantern focus:ring-lantern"
              />
              <span class="font-medium">{item.title}</span>
            </label>
          ))}
        </div>
        <p id="itinerary-empty" class="mt-4 hidden text-center text-sm text-ink/60">Tiada item dipilih lagi.</p>
      </div>
    </div>
  </section>

  {/* Map */}
  <section class="bg-ocean px-4 py-20 text-white sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 text-center">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">Lokasi Chew Jetty</h2>
        <p class="mx-auto mt-4 max-w-2xl text-white/80">Pengkalan Weld, George Town, Pulau Pinang — bersebelahan dengan jeti-jeti puak yang lain.</p>
      </div>
      <div class="overflow-hidden rounded-3xl shadow-float">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3972.0279263081957!2d100.33719201213927!3d5.412717494543811!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304ac38d0fb545e7%3A0xc1b12a535798fa94!2z5aeT5ZGo5qGl!5e0!3m2!1sen-US!2sus!4v1786584457500!5m2!1sen-US!2sus"
          width="100%"
          height="480"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Peta Chew Jetty di Google Maps"
        ></iframe>
      </div>
      <div class="mt-6 text-center">
        <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Arah ke Chew Jetty
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.55-4.55M19.55 5.45L15 10m4.55-4.55V10M4 20h16" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section id="faq" class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="mb-12 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Soalan Lazim</h2>
        <p class="mx-auto mt-4 max-w-xl text-ink/70">Jawapan ringkas untuk persoalan lazim sebelum anda melawat Chew Jetty.</p>
      </div>
      <FaqAccordion />
    </div>
  </section>

  {/* Sources */}
  <section id="sumber" class="bg-ocean-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="mb-10 text-center">
        <h2 class="font-display text-3xl font-bold text-ocean sm:text-4xl">Rujukan & Sumber</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">Maklumat dalam laman ini disusun daripada sumber yang boleh disemak berikut. Laman ini ialah panduan bebas dan bukan laman rasmi Chew Jetty.</p>
      </div>
      <ul class="space-y-3">
        {SOURCES.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-float"
            >
              <div>
                <p class="font-semibold text-ocean group-hover:text-lantern">{s.label}</p>
                <p class="mt-1 text-sm text-ink/60">{s.note}</p>
              </div>
              <svg class="h-5 w-5 flex-shrink-0 text-ocean-300 transition group-hover:text-lantern" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Lightbox */}
  <div id="lightbox" class="lightbox-backdrop" role="dialog" aria-modal="true" aria-label="Paparan gambar besar">
    <button id="lightbox-close" type="button" class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white backdrop-blur hover:bg-white/20">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <button id="lightbox-prev" type="button" class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white backdrop-blur hover:bg-white/20">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button id="lightbox-next" type="button" class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white backdrop-blur hover:bg-white/20">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl" />
  </div>

  <script is:inline define:vars={{ images: GALLERY.map((g) => g.src), alts: GALLERY.map((g) => g.alt) }}>
    (function () {
      const thumbs = document.querySelectorAll('.gallery-thumb');
      const lightbox = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightbox-img');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');
      let current = 0;

      function open(index) {
        current = index;
        lbImg.src = images[current];
        lbImg.alt = alts[current] || '';
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }

      function move(dir) {
        current = (current + dir + images.length) % images.length;
        lbImg.src = images[current];
        lbImg.alt = alts[current] || '';
      }

      thumbs.forEach((t) => {
        t.addEventListener('click', () => open(Number(t.dataset.index)));
      });

      closeBtn.addEventListener('click', close);
      prevBtn.addEventListener('click', (e) => { e.stopPropagation(); move(-1); });
      nextBtn.addEventListener('click', (e) => { e.stopPropagation(); move(1); });
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('active')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') move(-1);
        if (e.key === 'ArrowRight') move(1);
      });
    })();
  </script>

  <script is:inline>
    (function () {
      const STORAGE_KEY = 'chew-jetty-itinerary';
      const checkboxes = document.querySelectorAll('.itinerary-check');
      const countEl = document.getElementById('itinerary-count');
      const resetBtn = document.getElementById('itinerary-reset');
      const emptyEl = document.getElementById('itinerary-empty');

      function load() {
        try {
          const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          checkboxes.forEach((cb) => { cb.checked = saved.includes(cb.value); });
        } catch {}
        update();
      }

      function save() {
        const selected = Array.from(checkboxes).filter((cb) => cb.checked).map((cb) => cb.value);
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(selected)); } catch {}
        update();
      }

      function update() {
        const selected = Array.from(checkboxes).filter((cb) => cb.checked).length;
        countEl.textContent = selected + ' / ' + checkboxes.length + ' dipilih';
        emptyEl.classList.toggle('hidden', selected > 0);
      }

      checkboxes.forEach((cb) => cb.addEventListener('change', save));
      resetBtn.addEventListener('click', () => {
        checkboxes.forEach((cb) => { cb.checked = false; });
        save();
      });

      load();
    })();
  </script>
</BaseLayout>
