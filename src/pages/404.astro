---
import '@/styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Page not found | Chew Jetty</title>
    <meta name="description" content="Find the Chew Jetty visitor guide in English, Bahasa Melayu or Chinese." />
  </head>
  <body class="bg-sand text-ink">
    <main class="mx-auto max-w-3xl px-6 py-24">
      <p class="font-semibold">404</p>
      <h1 class="mt-4 text-4xl font-bold">Page not found</h1>
      <p class="mt-6">Return to the Chew Jetty visitor guide:</p>
      <nav class="mt-6 flex flex-wrap gap-6" aria-label="Choose language">
        <a href="/">Bahasa Melayu</a><a href="/en/">English</a><a href="/zh/">中文</a>
      </nav>
    </main>
  </body>
</html>
