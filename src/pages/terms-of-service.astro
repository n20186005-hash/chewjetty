---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = '服务条款 | Chew Jetty';
const pageDescription =
  'Chew Jetty 旅游指南网站的服务条款——内容使用、信息准确性、知识产权与责任限制。';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="px-4 pb-20 pt-28 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-ocean hover:text-lantern">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        返回首页
      </a>
      <h1 class="mt-6 font-display text-4xl font-bold text-ocean">服务条款</h1>
      <p class="mt-4 text-sm text-ink/60">最后更新时间：2026年8月</p>

      <p class="mt-8 leading-relaxed">
        访问和使用本网站，即表示您同意受这些服务条款的约束。
      </p>

      <div class="mt-10 space-y-10 text-ink/80">
        <div>
          <h2 class="font-display text-2xl font-bold text-ocean">内容使用</h2>
          <p class="mt-3 leading-relaxed">
            本网站所有内容仅供参考。我们是一家独立的第三方旅游信息网站，与任何旅游景点、政府机构或商业运营商均无关联。
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold text-ocean">信息的准确性</h2>
          <p class="mt-3 leading-relaxed">
            我们力求提供准确及时的信息，但无法保证信息的完整性或准确性。行程安排、条件和服务如有变更，恕不另行通知。
            请务必在出行前通过官方渠道核实重要信息。
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold text-ocean">知识产权</h2>
          <p class="mt-3 leading-relaxed">
            本网站设计和原创内容受版权保护。图片来自 Unsplash，并已获得其许可。Google 地图数据的使用符合 Google 的服务条款。
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold text-ocean">责任限制</h2>
          <p class="mt-3 leading-relaxed">
            本网站按“现状”提供，不作任何担保。对于因使用本网站信息而造成的任何损失，包括但不限于基于本网站内容做出的
            旅行决定，我们概不负责。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
