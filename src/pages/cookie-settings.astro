---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Cookie 设置 | Chew Jetty';
const pageDescription =
  'Chew Jetty 网站的 Cookie 偏好设置——管理必要 Cookie、分析型 Cookie、偏好 Cookie 与营销 Cookie。';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="px-4 pb-20 pt-28 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-ocean hover:text-lantern">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        返回首页
      </a>
      <h1 class="mt-6 font-display text-4xl font-bold text-ocean">Cookie 设置</h1>
      <p class="mt-4 text-sm text-ink/60">最后更新时间：2026年8月</p>

      <p class="mt-8 leading-relaxed">
        我们使用 Cookie 来改善您的浏览体验。您可以在下方管理您的偏好设置。
      </p>

      <div class="mt-10 space-y-6 text-ink/80">
        <div class="rounded-2xl border border-wood-200 bg-white p-6 shadow-card">
          <div class="flex items-start justify-between gap-6">
            <div>
              <h2 class="font-display text-xl font-bold text-ocean">必要 Cookie</h2>
              <p class="mt-2 text-sm leading-relaxed">这些 Cookie 对于网站正常运行至关重要，无法禁用。</p>
            </div>
            <span class="inline-flex flex-shrink-0 items-center gap-2 rounded-full bg-ocean-50 px-3 py-1 text-sm font-semibold text-ocean">
              <span class="h-2 w-2 rounded-full bg-ocean" aria-hidden="true"></span>
              始终保持活跃
            </span>
          </div>
        </div>

        <div class="rounded-2xl border border-wood-200 bg-white p-6 shadow-card">
          <div class="flex items-start justify-between gap-6">
            <div>
              <h2 class="font-display text-xl font-bold text-ocean">分析型 Cookie</h2>
              <p class="mt-2 text-sm leading-relaxed">它们通过收集匿名使用数据，帮助我们了解访客如何与我们的网站互动。</p>
            </div>
            <label class="flex flex-shrink-0 cursor-pointer items-center gap-3" data-cookie-group>
              <span class="text-sm font-semibold text-ink/70" data-toggle-label>激活</span>
              <input type="checkbox" class="peer sr-only" data-cookie-toggle="analytics" checked />
              <span class="relative h-6 w-11 rounded-full bg-wood-300 transition peer-checked:bg-ocean" aria-hidden="true">
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
              </span>
            </label>
          </div>
          <div class="mt-4 rounded-2xl bg-ocean-50 p-4">
            <p class="font-semibold text-ocean">Google Analytics</p>
            <p class="mt-1 text-sm">它会收集访客如何使用我们网站的匿名信息。</p>
          </div>
        </div>

        <div class="rounded-2xl border border-wood-200 bg-white p-6 shadow-card">
          <div class="flex items-start justify-between gap-6">
            <div>
              <h2 class="font-display text-xl font-bold text-ocean">偏好 Cookie</h2>
              <p class="mt-2 text-sm leading-relaxed">它们会记住您的设置，例如语言和主题偏好。</p>
            </div>
            <label class="flex flex-shrink-0 cursor-pointer items-center gap-3" data-cookie-group>
              <span class="text-sm font-semibold text-ink/70" data-toggle-label>激活</span>
              <input type="checkbox" class="peer sr-only" data-cookie-toggle="preferences" checked />
              <span class="relative h-6 w-11 rounded-full bg-wood-300 transition peer-checked:bg-ocean" aria-hidden="true">
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
              </span>
            </label>
          </div>
          <div class="mt-4 rounded-2xl bg-ocean-50 p-4">
            <p class="font-semibold text-ocean">用户偏好</p>
            <p class="mt-1 text-sm">保存您的语言偏好和网站设置。</p>
          </div>
        </div>

        <div class="rounded-2xl border border-wood-200 bg-white p-6 shadow-card">
          <div class="flex items-start justify-between gap-6">
            <div>
              <h2 class="font-display text-xl font-bold text-ocean">营销 Cookie</h2>
              <p class="mt-2 text-sm leading-relaxed">它们用于展示相关广告并衡量广告活动的有效性。</p>
            </div>
            <label class="flex flex-shrink-0 cursor-pointer items-center gap-3" data-cookie-group>
              <span class="text-sm font-semibold text-ink/70" data-toggle-label>停用</span>
              <input type="checkbox" class="peer sr-only" data-cookie-toggle="marketing" />
              <span class="relative h-6 w-11 rounded-full bg-wood-300 transition peer-checked:bg-ocean" aria-hidden="true">
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
              </span>
            </label>
          </div>
          <div class="mt-4 rounded-2xl bg-ocean-50 p-4">
            <p class="font-semibold text-ocean">个性化广告</p>
            <p class="mt-1 text-sm">它可以根据你的兴趣为你展示相关的广告。</p>
          </div>
        </div>

        <div class="rounded-2xl bg-sand p-6">
          <h2 class="font-display text-xl font-bold text-ocean">同意管理</h2>
          <p class="mt-2 text-sm leading-relaxed">
            您可以随时更改您的 Cookie 设置。请注意，禁用某些 Cookie 可能会影响网站的功能。
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="button"
            id="save-cookie-preferences"
            class="inline-flex items-center gap-2 rounded-full bg-ocean px-6 py-3 font-semibold text-white transition hover:bg-ocean-700"
          >
            保存偏好设置
          </button>
          <button
            type="button"
            id="reject-all-cookies"
            class="inline-flex items-center gap-2 rounded-full border border-wood-300 px-6 py-3 font-semibold text-ink transition hover:border-ocean hover:text-ocean"
          >
            拒绝一切
          </button>
          <p id="cookie-msg" class="hidden text-sm font-semibold text-ocean" role="status"></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const KEY = 'chewjetty_cookie_prefs';
    const toggles = Array.from(document.querySelectorAll('[data-cookie-toggle]'));
    const msg = document.getElementById('cookie-msg');

    function syncLabel(t) {
      const group = t.closest('[data-cookie-group]');
      const label = group.querySelector('[data-toggle-label]');
      label.textContent = t.checked ? '激活' : '停用';
    }

    function showMsg(text) {
      msg.textContent = text;
      msg.classList.remove('hidden');
      clearTimeout(showMsg._t);
      showMsg._t = setTimeout(() => msg.classList.add('hidden'), 3000);
    }

    function save() {
      const prefs = {};
      toggles.forEach((t) => {
        prefs[t.dataset.cookieToggle] = t.checked;
        syncLabel(t);
      });
      localStorage.setItem(KEY, JSON.stringify(prefs));
      showMsg('您的偏好设置已保存。');
    }

    function rejectAll() {
      toggles.forEach((t) => {
        if (t.dataset.cookieToggle !== 'marketing') return;
        t.checked = false;
        syncLabel(t);
      });
      save();
    }

    try {
      const prefs = JSON.parse(localStorage.getItem(KEY) || '{}');
      toggles.forEach((t) => {
        const id = t.dataset.cookieToggle;
        if (typeof prefs[id] === 'boolean') t.checked = prefs[id];
        syncLabel(t);
      });
    } catch (e) {}

    toggles.forEach((t) => t.addEventListener('change', () => syncLabel(t)));
    document.getElementById('save-cookie-preferences').addEventListener('click', save);
    document.getElementById('reject-all-cookies').addEventListener('click', rejectAll);
  })();
</script>
